<Window x:Class="LightBoard.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <StackPanel>
        <StackPanel Margin="25,20,25,20">
            <TextBlock Margin="0,0,0,8"
                       Foreground="#666666"
                       Text="所有设置保存后重启轻白板生效。" />
            <StackPanel>
                <CheckBox x:Name="HandEraserBox"
                          Margin="0,5,0,5"
                          IsEnabled="False"
                          Content="最小触点距离小于阈值 -&gt; 激活手掌擦" />
                <CheckBox x:Name="EdgeScrollHintBox" Margin="0,5,0,5" Content="边缘热区内有墨迹 -&gt; 显示滚动按钮" />
            </StackPanel>
            <Grid Margin="3,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="单指起笔位移阈值" />
                <TextBox x:Name="TouchDisplacementBox"
                         Grid.Row="0" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="双指平移锁定阈值" />
                <TextBox x:Name="PanZoomDisplaceBox"
                         Grid.Row="1" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="双指捏合锁定间距" />
                <TextBox x:Name="PinchLockBox"
                         Grid.Row="2" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="撤销历史条数" />
                <TextBox x:Name="MaxHistoryBox"
                         Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <Separator Grid.Row="4" Grid.ColumnSpan="3"
                           Margin="0,15,0,10" Background="#AAA0A0A0" />
                <TextBlock Grid.Row="5" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="上边缘热区" />
                <TextBox x:Name="EdgeScrollTopBox"
                         Grid.Row="5" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="5" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="下边缘热区" />
                <TextBox x:Name="EdgeScrollBottomBox"
                         Grid.Row="6" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="6" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="7" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="左边缘热区" />
                <TextBox x:Name="EdgeScrollLeftBox"
                         Grid.Row="7" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="7" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="8" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="右边缘热区" />
                <TextBox x:Name="EdgeScrollRightBox"
                         Grid.Row="8" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="8" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <Separator Grid.Row="9" Grid.ColumnSpan="3"
                           Margin="0,15,0,10" Background="#AAA0A0A0" />
                <TextBlock Grid.Row="10" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="橡皮触点数量" />
                <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                            Margin="0,5,0,5" Orientation="Horizontal">
                    <RadioButton x:Name="FourFingerEraserRadio"
                                 Margin="0,0,20,0"
                                 GroupName="PalmErase"
                                 Content="四指及以上" />
                    <RadioButton x:Name="FiveFingerEraserRadio"
                                 GroupName="PalmErase"
                                 Content="五指及以上" />
                </StackPanel>
                <TextBlock Grid.Row="11" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="橡皮直径" />
                <TextBox x:Name="EraserDiameterBox"
                         Grid.Row="11" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="11" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="12" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="掌擦外扩" />
                <TextBox x:Name="EraserPalmExtraBox"
                         Grid.Row="12" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="12" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="13" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="最小逻辑直径" />
                <TextBox x:Name="EraserMinDiameterBox"
                         Grid.Row="13" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="13" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
                <TextBlock Grid.Row="14" Grid.Column="0"
                           Margin="0,5,10,5" VerticalAlignment="Center"
                           Text="命中重建阈值" />
                <TextBox x:Name="EraserRebuildBox"
                         Grid.Row="14" Grid.Column="1"
                         MinWidth="120"
                         Margin="0,5,0,5" />
                <TextBlock Grid.Row="14" Grid.Column="2"
                           Margin="5,5,0,5" VerticalAlignment="Center"
                           Text="DIP" />
            </Grid>
        </StackPanel>
        <StackPanel Background="#F0F0F0">
            <StackPanel Margin="15" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="5,0,5,0" Padding="32,3"
                        Click="OkClick" Content="确定" />
                <Button Margin="5,0,5,0" Padding="32,3"
                        Click="CancelClick" Content="取消" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
