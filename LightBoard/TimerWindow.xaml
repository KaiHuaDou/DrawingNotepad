<Window x:Class="LightBoard.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightBoard"
        Title="{Binding Title}"
        Background="#141414"
        Foreground="#E6E6E6"
        MouseLeftButtonDown="WindowMouseLeftButtonDown"
        PreviewKeyDown="WindowKeyDown"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="TimerDigitBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="TimerAlertBrush" Color="#FF5252" />

        <Style x:Key="TimerDigitStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="96" />
            <Setter Property="Foreground" Value="{StaticResource TimerDigitBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TimerAlertBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="FontSize" Value="192" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--非全屏时隐藏也占位，开始与暂停不改变窗口尺寸；全屏收起让数字垂直居中-->
        <Style x:Key="TimerAdjustButtonStyle" BasedOn="{StaticResource ButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdjustable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--全屏只留数字：顶部行与主按钮共用同一处折叠条件-->
        <Style x:Key="HideInFullscreen" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerMainButtonStyle" BasedOn="{StaticResource ButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Tag" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="开始 / 暂停" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tag" Value="&#xE769;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--环的可见性跟随倒计时模式，全屏时让位给数字-->
        <Style x:Key="TimerDialStyle" TargetType="{x:Type local:TimerDial}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--暂停时数字变暗，与环的半透明同步-->
        <Style x:Key="TimerDigitsFrameStyle" TargetType="{x:Type Border}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--未开始：时与分各自居中，秒位不参与这一层的宽度-->
        <Style x:Key="TimerShortLayerStyle" TargetType="{x:Type Grid}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIdle}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--本轮内：带秒的一行居中；与上一行叠放，容器宽度取较宽的一份-->
        <Style x:Key="TimerFullLayerStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIdle}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <local:TimerViewModel />
    </Window.DataContext>

    <StackPanel Margin="50,50,50,50" VerticalAlignment="Center">
        <StackPanel Margin="0,0,0,25" HorizontalAlignment="Center"
                    Style="{StaticResource HideInFullscreen}"
                    Orientation="Horizontal">
            <RadioButton x:Name="CountdownRadio"
                         Margin="0,0,10,0"
                         IsChecked="True"
                         IsEnabled="{Binding IsIdle}"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="倒计时" GroupName="TimeModeRadio" ToolTip="倒计时" />
            <RadioButton x:Name="CountupRadio"
                         Margin="10,0,10,0"
                         IsEnabled="{Binding IsIdle}"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="计时器" GroupName="TimeModeRadio" ToolTip="计时器" />
            <Button x:Name="ResetButton"
                    Margin="10,0,0,0"
                    IsEnabled="{Binding CanReset}"
                    Style="{StaticResource ButtonStyle}"
                    Click="ResetClick" Tag="&#xE72C;" ToolTip="重置本轮" />
            <Button x:Name="FullscreenButton"
                    Margin="10,0,0,0"
                    Style="{StaticResource ButtonStyle}"
                    Click="FullscreenClick" Tag="&#xE740;" ToolTip="全屏" />
        </StackPanel>
        <Grid x:Name="ClockGrid"
              Margin="0,25,0,25" HorizontalAlignment="Center"
              Background="Transparent"
              MouseLeftButtonDown="ClockMouseLeftButtonDown"
              MouseLeftButtonUp="ClockMouseLeftButtonUp" MouseMove="ClockMouseMove">
            <local:TimerDial x:Name="Dial"
                             Width="{Binding ActualWidth, ElementName=DialBorder}"
                             Height="{Binding ActualWidth, ElementName=DialBorder}"
                             Style="{StaticResource TimerDialStyle}"
                             IsAlerting="{Binding IsAlerting}"
                             IsPaused="{Binding IsPaused}" />
            <!--内边距让出描边，环的外接方边长取这一块的宽度-->
            <Border x:Name="DialBorder"
                    Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TimerDigitsFrameStyle}">
                <Grid>
                    <Grid x:Name="ShortLayer"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Style="{StaticResource TimerShortLayerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="HourUpButton"
                                Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TimerAdjustButtonStyle}"
                                Click="HourClick" Tag="&#xE710;" ToolTip="加一小时" />
                        <Button x:Name="MinuteUpButton"
                                Grid.Row="0" Grid.Column="2"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TimerAdjustButtonStyle}"
                                Click="MinuteClick" Tag="&#xE710;" ToolTip="加一分钟" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0,15,0,15" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Hours, StringFormat={}{0:00}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Margin="0,15,0,15" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text=":" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Margin="0,15,0,15" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Minutes, StringFormat={}{0:00}}" />
                        <Button x:Name="HourDownButton"
                                Grid.Row="2" Grid.Column="0"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding CanDecreaseHour}"
                                Style="{StaticResource TimerAdjustButtonStyle}"
                                Click="HourClick" Tag="&#xE738;" ToolTip="减一小时" />
                        <Button x:Name="MinuteDownButton"
                                Grid.Row="2" Grid.Column="2"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding CanDecreaseMinute}"
                                Style="{StaticResource TimerAdjustButtonStyle}"
                                Click="MinuteClick" Tag="&#xE738;" ToolTip="减一分钟" />
                    </Grid>
                    <StackPanel x:Name="FullLayer"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Style="{StaticResource TimerFullLayerStyle}"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Hours, StringFormat={}{0:00}}" />
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text=":" />
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Minutes, StringFormat={}{0:00}}" />
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text=":" />
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Seconds, StringFormat={}{0:00}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Style="{StaticResource HideInFullscreen}">
            <Button x:Name="TimerButton"
                    IsEnabled="{Binding CanToggle}"
                    Style="{StaticResource TimerMainButtonStyle}"
                    Click="TimerClick" />
        </Grid>
    </StackPanel>
</Window>
