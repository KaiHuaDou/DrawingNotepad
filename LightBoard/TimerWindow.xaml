<Window x:Class="LightBoard.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒计时"
        Background="#141414"
        Foreground="#E6E6E6"
        MouseLeftButtonDown="WindowMouseLeftButtonDown"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="50,20,50,20" VerticalAlignment="Center">
        <StackPanel x:Name="ModeRow"
                    Margin="0,0,0,20" HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <RadioButton x:Name="CountdownRadio"
                         Margin="0,0,10,0"
                         IsChecked="True"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="倒计时" GroupName="TimeModeRadio"
                         Tag="&#xE917;" />
            <RadioButton x:Name="CountupRadio"
                         Margin="10,0,0,0"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="计时器" GroupName="TimeModeRadio"
                         Tag="&#xE917;" />
            <Button x:Name="ResetButton"
                    Style="{StaticResource ButtonStyle}"
                    Click="ResetClick" Tag="&#xE72C;" />
        </StackPanel>
        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="HourUpButton"
                    Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="HourClick" Tag="&#xE710;" />
            <Button x:Name="MinuteUpButton"
                    Grid.Row="0" Grid.Column="2"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="MinuteClick" Tag="&#xE710;" />
            <TextBlock x:Name="HourText"
                       Grid.Row="1" Grid.Column="0"
                       Margin="0,20,0,20" HorizontalAlignment="Center"
                       FontFamily="Consolas" FontSize="96"
                       Text="00" />
            <TextBlock x:Name="Separator1Text"
                       Grid.Row="1" Grid.Column="1"
                       Margin="10,20,10,20" HorizontalAlignment="Center"
                       FontFamily="Consolas" FontSize="96"
                       Text=":" />
            <TextBlock x:Name="MinuteText"
                       Grid.Row="1" Grid.Column="2"
                       Margin="10,20,10,20" HorizontalAlignment="Center"
                       FontFamily="Consolas" FontSize="96"
                       Text="00" />
            <StackPanel x:Name="SecondsPanel"
                        Grid.Row="1" Grid.Column="3"
                        Width="0"
                        ClipToBounds="True" Orientation="Horizontal">
                <TextBlock x:Name="Separator2Text"
                           Margin="10,20,10,20" HorizontalAlignment="Center"
                           FontFamily="Consolas" FontSize="96"
                           Text=":" />
                <TextBlock x:Name="SecondText"
                           Margin="0,20,0,20" HorizontalAlignment="Center"
                           FontFamily="Consolas" FontSize="96"
                           Text="00" />
            </StackPanel>
            <Button x:Name="HourDownButton"
                    Grid.Row="2" Grid.Column="0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="HourClick" Tag="&#xE738;" />
            <Button x:Name="MinuteDownButton"
                    Grid.Row="2" Grid.Column="2"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="MinuteClick" Tag="&#xE738;" />
            <UniformGrid x:Name="PresetRow"
                         Grid.Row="3" Grid.ColumnSpan="4"
                         Margin="0,20,0,0" HorizontalAlignment="Center"
                         Rows="2">
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="00:05" Tag="5" />
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="00:10" Tag="10" />
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="00:30" Tag="30" />
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="01:15" Tag="75" />
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="01:30" Tag="90" />
                <Button Style="{StaticResource TextButtonStyle}"
                        Click="PresetClick" Content="02:00" Tag="120" />
            </UniformGrid>
            <Button x:Name="TimerButton"
                    Grid.Row="4" Grid.ColumnSpan="4"
                    Width="54" Height="54"
                    Margin="0,20,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="TimerClick" Tag="&#xE768;" />
        </Grid>
    </StackPanel>
</Window>
