<Window x:Class="LightBoard.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightBoard"
        Title="{Binding Title}"
        MinWidth="512"
        MinHeight="600"
        Background="#141414"
        Foreground="#E6E6E6"
        MouseLeftButtonDown="WindowMouseLeftButtonDown"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="TimerDigitBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="TimerAlertBrush" Color="#FF5252" />
        <SolidColorBrush x:Key="TimerRingBrush" Color="#D8FFFFFF" />
        <SolidColorBrush x:Key="TimerRingTrackBrush" Color="#333333" />

        <Style x:Key="TimerDigitStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="96" />
            <Setter Property="Foreground" Value="{StaticResource TimerDigitBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TimerAlertBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="FontSize" Value="192" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--非全屏时隐藏也占位，开始与暂停不改变窗口尺寸；全屏收起让数字垂直居中-->
        <Style x:Key="TimerAdjustButtonStyle" BasedOn="{StaticResource ButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdjustable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerFrameStyle" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--环的可见性跟随倒计时模式，全屏时让位给数字-->
        <Style x:Key="TimerRingAreaStyle" TargetType="{x:Type Canvas}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerRingProgressStyle" TargetType="{x:Type Path}">
            <Setter Property="Stroke" Value="{StaticResource TimerRingBrush}" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource TimerAlertBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <local:TimerViewModel />
    </Window.DataContext>

    <StackPanel Margin="50,0,50,0" VerticalAlignment="Center">
        <StackPanel Margin="0,0,0,25" HorizontalAlignment="Center"
                    Style="{StaticResource TimerFrameStyle}"
                    Orientation="Horizontal">
            <RadioButton x:Name="CountdownRadio"
                         Margin="0,0,10,0"
                         IsChecked="True"
                         IsEnabled="{Binding IsIdle}"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="倒计时" GroupName="TimeModeRadio" />
            <RadioButton x:Name="CountupRadio"
                         Margin="10,0,10,0"
                         IsEnabled="{Binding IsIdle}"
                         Style="{StaticResource LabelledRadioStyle}"
                         Click="ModeClick" Content="计时器" GroupName="TimeModeRadio" />
            <Button x:Name="ResetButton"
                    Margin="10,0,0,0"
                    IsEnabled="{Binding CanReset}"
                    Style="{StaticResource ButtonStyle}"
                    Click="ResetClick" Tag="&#xE72C;" />
            <Button x:Name="FullscreenButton"
                    Margin="10,0,0,0"
                    Style="{StaticResource ButtonStyle}"
                    Click="FullscreenClick" Tag="&#xE740;" />
        </StackPanel>
        <Grid x:Name="ClockGrid"
              Margin="0,25,0,25" HorizontalAlignment="Center"
              Background="Transparent"
              MouseLeftButtonDown="ClockMouseLeftButtonDown"
              MouseLeftButtonUp="ClockMouseLeftButtonUp" MouseMove="ClockMouseMove">
            <Canvas x:Name="RingCanvas"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TimerRingAreaStyle}">
                <Path x:Name="RingTrackPath" Stroke="{StaticResource TimerRingTrackBrush}" StrokeThickness="8" />
                <Path x:Name="RingProgressPath" Style="{StaticResource TimerRingProgressStyle}" StrokeThickness="8" />
            </Canvas>
            <!--内边距让出描边，环的外接方边长取这一块的宽度-->
            <Border x:Name="DialBorder"
                    Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    SizeChanged="DialSizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="HourUpButton"
                            Grid.Row="0" Grid.Column="0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TimerAdjustButtonStyle}"
                            Click="HourClick" Tag="&#xE710;" />
                    <Button x:Name="MinuteUpButton"
                            Grid.Row="0" Grid.Column="2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TimerAdjustButtonStyle}"
                            Click="MinuteClick" Tag="&#xE710;" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,20,0,20" HorizontalAlignment="Center"
                               Style="{StaticResource TimerDigitStyle}"
                               Text="{Binding Hours, StringFormat={}{0:00}}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="0,20,0,20" HorizontalAlignment="Center"
                               Style="{StaticResource TimerDigitStyle}"
                               Text=":" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Margin="0,20,0,20" HorizontalAlignment="Center"
                               Style="{StaticResource TimerDigitStyle}"
                               Text="{Binding Minutes, StringFormat={}{0:00}}" />
                    <StackPanel x:Name="SecondsPanel"
                                Grid.Row="1" Grid.Column="3"
                                Width="0"
                                ClipToBounds="True" Orientation="Horizontal">
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text=":" />
                        <TextBlock Margin="0,20,0,20" HorizontalAlignment="Center"
                                   Style="{StaticResource TimerDigitStyle}"
                                   Text="{Binding Seconds, StringFormat={}{0:00}}" />
                    </StackPanel>
                    <Button x:Name="HourDownButton"
                            Grid.Row="2" Grid.Column="0"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding CanDecreaseHour}"
                            Style="{StaticResource TimerAdjustButtonStyle}"
                            Click="HourClick" Tag="&#xE738;" />
                    <Button x:Name="MinuteDownButton"
                            Grid.Row="2" Grid.Column="2"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding CanDecreaseMinute}"
                            Style="{StaticResource TimerAdjustButtonStyle}"
                            Click="MinuteClick" Tag="&#xE738;" />
                </Grid>
            </Border>
        </Grid>
        <Button x:Name="TimerButton"
                Width="72" Height="72"
                HorizontalAlignment="Center"
                IsEnabled="{Binding CanToggle}"
                FontSize="34"
                Click="TimerClick">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonStyle}" TargetType="{x:Type Button}">
                    <Setter Property="Tag" Value="&#xE768;" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Tag" Value="&#xE769;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</Window>
