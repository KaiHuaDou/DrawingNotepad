<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--纯白底色下的窗口 chrome 配色：实心浅灰面板配细描边，只挂在 MainWindow 上-->
    <SolidColorBrush x:Key="ContainerBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="ContainerBrushSolid" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="ChromeSurfaceBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="ChromeSelectedBrush" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="ChromeSelectedBorderBrush" Color="#FF7EB3E0" />
    <SolidColorBrush x:Key="ChromeDisabledBrush" Color="#FF9E9E9E" />
    <SolidColorBrush x:Key="ChromeDangerBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#CC595959" />
    <SolidColorBrush x:Key="ChromeEdgeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="PopupSeparatorBrush" Color="#1A000000" />
    <DropShadowEffect x:Key="PopupShadow"
                      Opacity="0.16"
                      BlurRadius="16" Direction="270" ShadowDepth="5"
                      Color="#000000" />
</ResourceDictionary>
