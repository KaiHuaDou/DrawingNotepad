<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <PropertyGroup>
        <WithOpenCv Condition="'$(WithOpenCv)' == ''">true</WithOpenCv>
        <OpenCvDirSuffix Condition="'$(WithOpenCv)' != 'true'">-nocv</OpenCvDirSuffix>
        <DefineConstants Condition="'$(WithOpenCv)' == 'true'">$(DefineConstants);OPENCV</DefineConstants>
    </PropertyGroup>
    <PropertyGroup>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
        <StartupObject>LightBoard.App.Program</StartupObject>
        <WarningLevel>8</WarningLevel>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration)==Debug">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration)==Release">
        <DebugType>none</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <Resource Include="Segoe Fluent Icons.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Resource>
        <Folder Include="Properties\" />
        <None Include="..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="LightBoard.Tests" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="DependencyPropertyGenerator" Version="1.5.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NetOfficeFw.PowerPoint" Version="1.9.12" />
        <PackageReference Include="NetOfficeFw.Word" Version="1.9.12" />
        <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
        <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261018" Condition="'$(WithOpenCv)' == 'true'" />
        <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261018" Condition="'$(WithOpenCv)' == 'true'" />
        <PackageReference Include="OpenCvSharp5.WpfExtensions" Version="5.0.0.20261018" Condition="'$(WithOpenCv)' == 'true'" />
        <PackageReference Include="PDFiumCore" Version="157.0.8100" />
        <PackageReference Include="SingleInstanceCore" Version="2.2.2" />
    </ItemGroup>
</Project>
