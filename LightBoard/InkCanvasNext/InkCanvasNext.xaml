<UserControl x:Class="InkCanvasNext.InkCanvasNext"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EdgeHintStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E3E3E3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#99132032" CornerRadius="5" />
                            <Border x:Name="HintOverlay" Background="Transparent" CornerRadius="5" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HintOverlay" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HintOverlay" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewMouseWheel="CanvasPreviewMouseWheel">
        <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="CanvasGrid" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border x:Name="DocumentHost"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="Collapsed" />
                <InkCanvas x:Name="InnerCanvas"
                           Panel.ZIndex="36"
                           Background="Transparent"
                           LostTouchCapture="CanvasLostTouchCapture"
                           PreviewMouseDown="CanvasPreviewMouseDown"
                           PreviewMouseMove="CanvasPreviewMouseMove" PreviewMouseUp="CanvasPreviewMouseUp"
                           PreviewTouchDown="CanvasPreviewTouchDown"
                           PreviewTouchMove="CanvasPreviewTouchMove" PreviewTouchUp="CanvasPreviewTouchUp"
                           Stylus.IsPressAndHoldEnabled="False" TouchLeave="CanvasTouchLeave"
                           UseCustomCursor="True">
                    <InkCanvas.DefaultDrawingAttributes>
                        <DrawingAttributes Width="3" Height="3"
                                           FitToCurve="True" StylusTip="Ellipse"
                                           Color="#E6E6E6" />
                    </InkCanvas.DefaultDrawingAttributes>
                </InkCanvas>
                <Canvas x:Name="SelectionLayer" Panel.ZIndex="37" IsHitTestVisible="False" />
                <Canvas x:Name="ShapePreviewLayer" Panel.ZIndex="38" IsHitTestVisible="False">
                    <Line x:Name="ShapePreviewLine"
                          Visibility="Collapsed"
                          Stroke="White" StrokeThickness="3" />
                    <Ellipse x:Name="ShapePreviewEllipse"
                             Visibility="Collapsed"
                             Fill="Transparent" Stroke="White" StrokeThickness="3" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <Canvas x:Name="EraserOverlayCanvas"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Background="Transparent">
            <Ellipse x:Name="EraserFeedback"
                     Width="0" Height="0"
                     Visibility="Collapsed"
                     Fill="#E6E6E6" Stroke="#1E1E1E" StrokeThickness="2" />
        </Canvas>

        <!-- 箭头坐标内缩 1（笔宽 2 的一半）：Shape 的自然尺寸取笔迹外沿的 Right/Bottom，内缩后笔迹填满尺寸盒，居中才准确 -->
        <Canvas x:Name="EdgeHintLayer" Panel.ZIndex="2">
            <Button x:Name="TopEdgeHint"
                    Visibility="Collapsed"
                    Style="{StaticResource EdgeHintStyle}"
                    Click="TopEdgeHintClick">
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      Data="M 1,9 L 8,1 L 15,9" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" />
            </Button>
            <Button x:Name="BottomEdgeHint"
                    Visibility="Collapsed"
                    Style="{StaticResource EdgeHintStyle}"
                    Click="BottomEdgeHintClick">
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      Data="M 1,1 L 8,9 L 15,1" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" />
            </Button>
            <Button x:Name="LeftEdgeHint"
                    Visibility="Collapsed"
                    Style="{StaticResource EdgeHintStyle}"
                    Click="LeftEdgeHintClick">
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      Data="M 9,1 L 1,8 L 9,15" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" />
            </Button>
            <Button x:Name="RightEdgeHint"
                    Visibility="Collapsed"
                    Style="{StaticResource EdgeHintStyle}"
                    Click="RightEdgeHintClick">
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      Data="M 1,1 L 9,8 L 1,15" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" />
            </Button>
        </Canvas>
    </Grid>
</UserControl>
