<UserControl x:Class="InkCanvasNext.InkCanvasNext"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid PreviewMouseWheel="CanvasPreviewMouseWheel">
        <Canvas x:Name="ViewportHost" ClipToBounds="True">
            <Grid x:Name="TranslateHost">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CanvasTranslate" />
                </Grid.RenderTransform>
                <Grid x:Name="CanvasGrid" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <Border x:Name="DocumentHost"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="Collapsed" />
                    <Canvas x:Name="SelectionLayer" Panel.ZIndex="37" IsHitTestVisible="False" />
                    <Canvas x:Name="ShapePreviewLayer" Panel.ZIndex="38" IsHitTestVisible="False">
                        <Line x:Name="ShapePreviewLine"
                              Visibility="Collapsed"
                              Stroke="White" StrokeThickness="3" />
                        <Ellipse x:Name="ShapePreviewEllipse"
                                 Visibility="Collapsed"
                                 Fill="Transparent" Stroke="White" StrokeThickness="3" />
                    </Canvas>
                </Grid>
            </Grid>
        </Canvas>

        <Canvas x:Name="EraserOverlayCanvas" Panel.ZIndex="1" IsHitTestVisible="False">
            <Grid x:Name="EraserFeedback"
                  Width="0" Height="0"
                  Visibility="Collapsed">
                <Ellipse Fill="#AAFEFEFE" Stroke="#AA333333" StrokeThickness="2" />
                <TextBlock x:Name="EraserFeedbackLabel"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="#1E1E1E"
                           FontSize="22" FontWeight="Bold" />
            </Grid>
        </Canvas>

        <Canvas x:Name="PenCursorLayer" Panel.ZIndex="64" IsHitTestVisible="False">
            <Grid x:Name="PenCursorMark"
                  Width="0" Height="0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PenCursorOffset" />
                </Grid.RenderTransform>
                <Ellipse Fill="Transparent" Stroke="#1E1E1E" StrokeThickness="3" />
                <Ellipse Fill="Transparent" Stroke="#E6E6E6" StrokeThickness="1" />
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
