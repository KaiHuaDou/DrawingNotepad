<Window x:Class="LightBoard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        MinHeight="420"
        Background="#141414"
        Foreground="#E8E8E8"
        ResizeMode="NoResize"
        SizeToContent="Height"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ControlTemplate x:Key="FieldErrorTemplate">
            <Border BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="4" />
        </ControlTemplate>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F0F0F0" />
        </Style>

        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7A7A7A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7A7A7A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="CaretBrush" Value="#F0F0F0" />
            <Setter Property="SelectionBrush" Value="#4C8BF5" />
            <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A" />
                                <Setter TargetName="PART_Border" Property="Background" Value="#171717" />
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#2C2C2C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A" />
                                <Setter TargetName="PART_Border" Property="Background" Value="#1A1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel MinHeight="40" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Box"
                                    DockPanel.Dock="Right"
                                    Width="23" Height="23"
                                    VerticalAlignment="Center"
                                    Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                    CornerRadius="5">
                                <Path x:Name="PART_Mark"
                                      Width="10" Height="8"
                                      Visibility="Collapsed"
                                      Stroke="#4C8BF5" StrokeThickness="1.8"
                                      Data="M 0,3.5 L 3.2,6.6 L 9,0.6" Stretch="Fill" StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Box" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Box" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                            <BulletDecorator.Bullet>
                                <Border x:Name="PART_Ring"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                        CornerRadius="9">
                                    <Ellipse x:Name="PART_Dot"
                                             Width="6" Height="6"
                                             Visibility="Collapsed"
                                             Fill="#4C8BF5" />
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FieldTemplate">
            <DockPanel MinHeight="40">
                <TextBlock DockPanel.Dock="Right"
                           Width="72"
                           Margin="12,0,0,0"
                           Style="{StaticResource UnitTextStyle}"
                           Text="{Binding Unit}" />
                <Button DockPanel.Dock="Right"
                        Margin="4,0,0,0"
                        Style="{StaticResource StepperButtonStyle}"
                        Click="StepUpClick" Content="+"
                        Tag="{Binding}" />
                <TextBox DockPanel.Dock="Right"
                         Width="92" Height="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource ValueBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center"
                         ToolTip="{Binding Hint}"
                         Validation.ErrorTemplate="{StaticResource FieldErrorTemplate}" />
                <Button DockPanel.Dock="Right"
                        Margin="0,0,4,0"
                        Style="{StaticResource StepperButtonStyle}"
                        Click="StepDownClick" Content="−"
                        Tag="{Binding}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#141414">
            <DockPanel Margin="20,15">
                <Button DockPanel.Dock="Left"
                        MinWidth="120"
                        Style="{StaticResource TextButtonStyle}"
                        Click="ResetClick" Content="恢复默认值" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button MinWidth="96"
                            Margin="0,0,8,0"
                            Style="{StaticResource TextButtonStyle}"
                            Click="OkClick" Content="确定" IsDefault="True" />
                    <Button MinWidth="96"
                            Style="{StaticResource TextButtonStyle}"
                            Content="取消" IsCancel="True" />
                </StackPanel>
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"
                           Foreground="#FF6B6B"
                           FontSize="15"
                           Text="有输入不合范围" />
            </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25,30,25">
                <TextBlock Style="{StaticResource NoteTextStyle}" Text="所有设置保存后重启轻白板生效。" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="手势" />
                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}" ItemsSource="{Binding GestureFields}" />
                <CheckBox IsChecked="{Binding SmoothZoom}" Style="{StaticResource RowCheckBoxStyle}" Content="双指缩放按平滑曲线跟随" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="边缘滚动提示" />
                <CheckBox IsChecked="{Binding EdgeScrollHint}" Style="{StaticResource RowCheckBoxStyle}" Content="热区内有墨迹时显示滚动按钮" />
                <ItemsControl IsEnabled="{Binding EdgeScrollHint}" ItemTemplate="{StaticResource FieldTemplate}" ItemsSource="{Binding EdgeFields}" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="橡皮" />
                <CheckBox IsEnabled="False" Style="{StaticResource RowCheckBoxStyle}" Content="手指最小距离小于阈值 → 激活手掌擦" />
                <DockPanel MinHeight="40">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <RadioButton Margin="0,0,20,0"
                                     IsChecked="{Binding FourFingerErase}"
                                     Style="{StaticResource FlatRadioStyle}"
                                     Content="四指及以上" GroupName="PalmErase" />
                        <RadioButton IsChecked="{Binding FiveFingerErase}"
                                     Style="{StaticResource FlatRadioStyle}"
                                     Content="五指及以上" GroupName="PalmErase" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="掌擦触点数量" />
                </DockPanel>
                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}" ItemsSource="{Binding EraserFields}" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="撤销" />
                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}" ItemsSource="{Binding UndoFields}" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="工具栏" />
                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}" ItemsSource="{Binding ToolbarFields}" />

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="切换目标" />
                <DockPanel MinHeight="40">
                    <TextBlock DockPanel.Dock="Right" Width="72" Margin="12,0,0,0" />
                    <TextBox DockPanel.Dock="Right"
                             Width="172" Height="36"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource ValueBoxStyle}"
                             Text="{Binding SwitchOutProcess, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="切换目标进程" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
