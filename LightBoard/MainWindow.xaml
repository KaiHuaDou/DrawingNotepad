<Window x:Class="LightBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightBoard"
        xmlns:next="clr-namespace:InkCanvasNext"
        Title="轻白板"
        Width="1920"
        Height="1080"
        Closing="WindowClosing"
        Deactivated="WindowDeactivated"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <ContentPresenter ClipToBounds="True" />
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <ResourceDictionary Source="/Theme.xaml" />
    </Window.Resources>
    <Grid>
        <next:InkCanvasNext x:Name="CanvasNext"
                            Background="{StaticResource MajorGridBrush}"
                            CanRedoChanged="CanvasNextCanRedoChanged"
                            CanUndoChanged="CanvasNextCanUndoChanged"
                            SelectionChanged="CanvasNextSelectionChanged"
                            StrokesChanged="CanvasNextStrokesChanged" />
        <Border x:Name="LeftBorder"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Style="{StaticResource ContainerStyle}"
                CornerRadius="0,10,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LeftTransform" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ExitButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="CloseWindowClick" Tag="&#xE711;" />
                <Button x:Name="WindowMinimizeButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="MinimizeWindowClick" Tag="&#xE921;" />
                <ToggleButton x:Name="MoreButton" Style="{StaticResource ToggleStyle}" Tag="&#xE700;" />
                <Button x:Name="SwitchOutButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="SwitchOutClick" Tag="&#xE8AB;" />
            </StackPanel>
        </Border>
        <Popup x:Name="MorePopup"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=MoreButton, Mode=TwoWay}"
               Placement="Top"
               PlacementTarget="{Binding ElementName=MoreButton}"
               StaysOpen="False">
            <Border Padding="5" Background="#F0F0F0" CornerRadius="10">
                <Menu Background="Transparent">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Header="关于" Style="{StaticResource MenuItemStyle}" Click="AboutClick">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE946;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="打开" Style="{StaticResource MenuItemStyle}" Click="OpenFileClick">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8DA;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="保存" Style="{StaticResource MenuItemStyle}" Click="SaveFileClick">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE74E;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ExportImageMenu" Header="导出"
                              Style="{StaticResource MenuItemStyle}"
                              Click="ExportImageClick">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEE71;" />
                        </MenuItem.Icon>
                    </MenuItem>
                </Menu>
            </Border>
        </Popup>
        <Border x:Name="CenterBorder"
                Height="48"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Style="{StaticResource ContainerStyle}"
                CornerRadius="10,10,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CenterTransform" />
            </Border.RenderTransform>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#1E1E1E"
                                 GroupName="EditGroup" />
                    <RadioButton x:Name="DefaultColorRadio"
                                 Checked="ColorRadioChecked" IsChecked="True"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#E6E6E6"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#FF4345"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#D7BA7D"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#ECD201"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#9184EE"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#569CD6"
                                 GroupName="EditGroup" />
                    <RadioButton Checked="ColorRadioChecked"
                                 Style="{StaticResource ColorRadioStyle}"
                                 Background="#4EC9B0"
                                 GroupName="EditGroup" />
                    <ToggleButton x:Name="HighLighterToggle"
                                  Style="{StaticResource ToggleStyle}"
                                  Click="HighLighterBoxClicked" Tag="&#xE7E6;" />
                    <Border Width="36" Visibility="Hidden" />
                    <RadioButton Checked="ToolRadioChecked"
                                 Style="{StaticResource RadioStyle}"
                                 GroupName="EditGroup" Tag="&#xED60;" />
                    <Button Style="{StaticResource ButtonStyle}"
                            Foreground="#F25767"
                            Click="EraseAll" Tag="&#xED62;" />
                    <Button x:Name="UndoButton"
                            IsEnabled="False"
                            Style="{StaticResource ButtonStyle}"
                            Click="UndoButtonClick" Tag="&#xE7A7;" />
                    <Button x:Name="RedoButton"
                            IsEnabled="False"
                            Style="{StaticResource ButtonStyle}"
                            Click="RedoButtonClick" Tag="&#xE7A6;" />
                    <ToggleButton x:Name="MoreToggle"
                                  Style="{StaticResource ToggleStyle}"
                                  Click="MoreToggleClick" Tag="&#xE712;" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="106" Visibility="Hidden" />
                    <RadioButton MinWidth="1"
                                 Checked="ThicknessRadioClick"
                                 Style="{StaticResource SelectiveRadioStyle}"
                                 GroupName="ThicknessGroup" />
                    <RadioButton x:Name="DefaultThicknessRadio"
                                 MinWidth="3"
                                 Checked="ThicknessRadioClick" IsChecked="True"
                                 Style="{StaticResource SelectiveRadioStyle}"
                                 GroupName="ThicknessGroup" />
                    <RadioButton MinWidth="5"
                                 Checked="ThicknessRadioClick"
                                 Style="{StaticResource SelectiveRadioStyle}"
                                 GroupName="ThicknessGroup" />
                    <RadioButton MinWidth="10"
                                 Checked="ThicknessRadioClick"
                                 Style="{StaticResource SelectiveRadioStyle}"
                                 GroupName="ThicknessGroup" />
                    <Border Width="140" Visibility="Hidden" />
                    <RadioButton Checked="ToolRadioChecked"
                                 Style="{StaticResource RadioStyle}"
                                 GroupName="EditGroup" Tag="&#xED61;" />
                    <RadioButton Checked="ToolRadioChecked"
                                 Style="{StaticResource RadioStyle}"
                                 GroupName="EditGroup" Tag="&#xEF20;" />
                    <Button x:Name="TransparentModeButton"
                            Style="{StaticResource ButtonStyle}"
                            Click="TransparentModeClick" Tag="&#xE729;" />
                    <Button Style="{StaticResource ButtonStyle}" Click="PasteClick" Tag="&#xE77F;" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="RightBorder"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{StaticResource ContainerStyle}"
                CornerRadius="10,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RightTransform" />
            </Border.RenderTransform>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <ToggleButton x:Name="CollapseExpandButton"
                                  Style="{StaticResource ToggleStyle}"
                                  Click="CollapseExpandClick" Tag="&#xE70D;" />
                    <Button x:Name="PrevPageButton"
                            IsEnabled="False"
                            Style="{StaticResource ButtonStyle}"
                            Click="PrevPage" Tag="&#xE72B;" />
                    <ToggleButton x:Name="AllPageToogle"
                                  Width="60" Height="36"
                                  Margin="3,0,3,0"
                                  Click="AllPageToogleClick">
                        <TextBlock FontSize="19" Text="1/1" />
                    </ToggleButton>
                    <Button x:Name="NewNextPageButton"
                            Style="{StaticResource ButtonStyle}"
                            Click="NewNextPage" Tag="&#xE710;" />
                    <Border Width="36" Visibility="Hidden" />
                </StackPanel>
                <ListBox x:Name="PagePreviewsBox"
                         Visibility="Collapsed"
                         Background="{x:Null}"
                         BorderThickness="0"
                         ItemsSource="{x:Static local:App.Pages}"
                         SelectionChanged="PagePreviewsBoxSelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="DodgerBlue" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="CornflowerBlue" />
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:Page">
                            <StackPanel Margin="0,5,0,5" HorizontalAlignment="Stretch" Orientation="Horizontal">
                                <TextBlock Margin="5,0,10,0" VerticalAlignment="Center"
                                           Foreground="#E6E6E6"
                                           FontSize="19"
                                           Text="{Binding Number}" />
                                <Image HorizontalAlignment="Stretch" Source="{Binding Preview}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <TextBlock x:Name="TimeText"
                   Margin="0,20,25,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Panel.ZIndex="16"
                   Foreground="Gray"
                   FontSize="48" />
        <Border x:Name="LoadingBorder"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed"
                Style="{StaticResource ContainerStyle}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel Margin="24,20">
                <TextBlock x:Name="LoadingText"
                           HorizontalAlignment="Center"
                           Foreground="#E6E6E6"
                           FontSize="24"
                           Text="正在加载中..." />
                <ProgressBar x:Name="LoadingBar"
                             Width="280" Height="16"
                             Margin="0,16,0,0"
                             IsIndeterminate="True"
                             Maximum="100" Minimum="0" />
            </StackPanel>
        </Border>
        <Border x:Name="SelectionBorder"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed"
                Style="{StaticResource ContainerStyle}"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ButtonStyle}" Click="CopyClick" Tag="&#xE8C8;" />
                <Button Style="{StaticResource ButtonStyle}" Click="CutClick" Tag="&#xE8C6;" />
                <Button Style="{StaticResource ButtonStyle}" Click="DeleteClick" Tag="&#xE74D;" />
                <Button Style="{StaticResource ButtonStyle}" Click="CloneClick" Tag="&#xF413;" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
