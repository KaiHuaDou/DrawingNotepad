<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingBrush x:Key="MajorGridBrush"
                  TileMode="Tile" Viewport="0,0,100,100" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup RenderOptions.EdgeMode="Aliased">
                <GeometryDrawing Brush="#141414">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,100,100" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#232323" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="0,100" />
                            <LineGeometry StartPoint="0,0" EndPoint="100,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="DarkBrush" Color="#441C2BCC" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#6683FC" />

    <SolidColorBrush x:Key="HoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3AFFFFFF" />

    <SolidColorBrush x:Key="ContainerBrush" Color="#99132032" />
    <SolidColorBrush x:Key="ContainerBrushSolid" Color="#AA132032" />

    <SolidColorBrush x:Key="IconBrush" Color="#E3E3E3" />

    <!--深色控件：取 aero-theme-for-avalonia 的 Dark 变体配色，尺寸与行为由 BasedOn 继承-->
    <LinearGradientBrush x:Key="ButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3E3E3E" />
        <GradientStop Offset="0.5" Color="#373737" />
        <GradientStop Offset="0.5" Color="#292929" />
        <GradientStop Offset="1" Color="#1B1B1B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonInnerBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#484848" />
        <GradientStop Offset="1" Color="#3F3F3F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0C3159" />
        <GradientStop Offset="0.5" Color="#0A2D50" />
        <GradientStop Offset="0.5" Color="#08213C" />
        <GradientStop Offset="1" Color="#08192D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverInnerBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#004A7F" />
        <GradientStop Offset="1" Color="#024375" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonPressedFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#001840" />
        <GradientStop Offset="0.5" Color="#001437" />
        <GradientStop Offset="0.5" Color="#000823" />
        <GradientStop Offset="1" Color="#000014" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonPressedInnerBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#000B27" />
        <GradientStop Offset="1" Color="#00001B" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonOuterBorderBrush" Color="#000000" />
    <SolidColorBrush x:Key="ButtonHoverOuterBorderBrush" Color="#001729" />

    <LinearGradientBrush x:Key="ScrollBarTrackBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2A2A2A" />
        <GradientStop Offset="0.25" Color="#383838" />
        <GradientStop Offset="1" Color="#3B3B3B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScrollBarGlyphBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E0FFFFFF" />
        <GradientStop Offset="1" Color="#A0FFFFFF" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ContainerShadow"
                      Opacity="0.5"
                      BlurRadius="15" Direction="270" ShadowDepth="6"
                      Color="#333333" />

    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="pack://application:,,,/LightBoard;component/#Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
    </Style>

    <Style x:Key="ColorRadioStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="35" />
        <Setter Property="Height" Value="35" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#EEEEEEEE" BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PART_CheckMark"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   Foreground="#DDEEEEEE"
                                   FontFamily="Segoe Fluent Icons" FontSize="22" FontWeight="Bold"
                                   Text="&#xE73E;" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Width" Value="33" />
                            <Setter TargetName="PART_Border" Property="Height" Value="33" />
                            <Setter TargetName="PART_Border" Property="CornerRadius" Value="8" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Width" Value="30" />
                            <Setter TargetName="PART_Border" Property="Height" Value="30" />
                            <Setter TargetName="PART_Border" Property="CornerRadius" Value="8" />
                            <Setter TargetName="PART_CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="MinWidth" Value="1">
                            <Setter TargetName="PART_CheckMark" Property="Foreground" Value="#DD111111" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolButtonBaseStyle" TargetType="Control">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="RadioStyle" BasedOn="{StaticResource ToolButtonBaseStyle}" TargetType="{x:Type RadioButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PART_Border"
                            Background="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="PART_Icon"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource IconTextStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Tag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectiveRadioStyle" BasedOn="{StaticResource ToolButtonBaseStyle}" TargetType="{x:Type RadioButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PART_Border"
                            Background="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <Ellipse x:Name="PART_Ellipse"
                                 Width="{TemplateBinding MinWidth}"
                                 Height="{TemplateBinding MinWidth}"
                                 Fill="{StaticResource IconBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleStyle" BasedOn="{StaticResource ToolButtonBaseStyle}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PART_Border"
                            Background="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource IconTextStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Tag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonStyle" BasedOn="{StaticResource ToolButtonBaseStyle}" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border" Background="Transparent" CornerRadius="5">
                        <TextBlock x:Name="PART_IconText"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource IconTextStyle}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Tag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource PressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.75" />
                            <Setter TargetName="PART_IconText" Property="Foreground" Value="#AAAAAA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource PressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Content 为空时退化为 Tag 字形-->
    <Style x:Key="ImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border" Background="Transparent" CornerRadius="5">
                        <Grid>
                            <TextBlock x:Name="PART_IconText"
                                       Margin="5,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Style="{StaticResource IconTextStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                            <StackPanel x:Name="PART_Icon" Margin="5,0,5,0" Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center"
                                           FontSize="19"
                                           Text="切换到" />
                                <Image Width="24" Height="24"
                                       VerticalAlignment="Center"
                                       Source="{TemplateBinding Content}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="PART_IconText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource PressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.75" />
                            <Setter TargetName="PART_IconText" Property="Foreground" Value="#AAAAAA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Panel.ZIndex" Value="36" />
        <Setter Property="BorderBrush" Value="#66DDEEFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource ContainerBrush}" />
        <Setter Property="Effect" Value="{StaticResource ContainerShadow}" />
    </Style>

    <Style x:Key="PageTabStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PART_Border"
                            MinWidth="36"
                            Padding="8,0"
                            Background="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Margin="5" VerticalAlignment="Center"
                               FontSize="18"
                               Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="PART_Border"
                            Margin="2" Padding="8,4"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="7">
                        <DockPanel>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Icon" />
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" ContentSource="Header" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Background" Value="Transparent" />
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#33FFFFFF" CornerRadius="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LabelledToggleStyle" BasedOn="{StaticResource ToggleStyle}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource IconTextStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="19" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource DarkBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RadioButton 继承自 ToggleButton，模板与状态触发器全部取自 LabelledToggleStyle-->
    <Style x:Key="LabelledRadioStyle" BasedOn="{StaticResource LabelledToggleStyle}" TargetType="{x:Type RadioButton}" />

    <Style x:Key="DotFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2"
                               Stroke="#CCE3E3E3" StrokeThickness="1"
                               RadiusX="2" RadiusY="2" SnapsToDevicePixels="True" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarArrowStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="PART_Outer"
                            BorderBrush="{StaticResource ButtonOuterBorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border x:Name="PART_Inner"
                                Background="{StaticResource ButtonFaceBrush}"
                                BorderBrush="{StaticResource ButtonInnerBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Outer" Property="BorderBrush" Value="{StaticResource ButtonHoverOuterBorderBrush}" />
                            <Setter TargetName="PART_Inner" Property="Background" Value="{StaticResource ButtonHoverFaceBrush}" />
                            <Setter TargetName="PART_Inner" Property="BorderBrush" Value="{StaticResource ButtonHoverInnerBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Inner" Property="Background" Value="{StaticResource ButtonPressedFaceBrush}" />
                            <Setter TargetName="PART_Inner" Property="BorderBrush" Value="{StaticResource ButtonPressedInnerBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="PART_Outer"
                            BorderBrush="{StaticResource ButtonOuterBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Inner"
                                Background="{StaticResource ButtonFaceBrush}"
                                BorderBrush="{StaticResource ButtonInnerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Path x:Name="PART_Grip"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="#000000" StrokeThickness="1"
                                  Data="M 0,0 L 6,0 M 0,3 L 6,3 M 0,6 L 6,6" SnapsToDevicePixels="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Horizontal">
                            <Setter TargetName="PART_Grip" Property="Data" Value="M 0,0 L 0,6 M 3,0 L 3,6 M 6,0 L 6,6" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Outer" Property="BorderBrush" Value="{StaticResource ButtonHoverOuterBorderBrush}" />
                            <Setter TargetName="PART_Inner" Property="Background" Value="{StaticResource ButtonHoverFaceBrush}" />
                            <Setter TargetName="PART_Inner" Property="BorderBrush" Value="{StaticResource ButtonHoverInnerBorderBrush}" />
                            <Setter TargetName="PART_Grip" Property="Stroke" Value="#C0C0C0" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="PART_Inner" Property="Background" Value="{StaticResource ButtonPressedFaceBrush}" />
                            <Setter TargetName="PART_Inner" Property="BorderBrush" Value="{StaticResource ButtonPressedInnerBorderBrush}" />
                            <Setter TargetName="PART_Grip" Property="Stroke" Value="#C0C0C0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
        <Setter Property="MinWidth" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                            <RowDefinition Height="0.00001*" />
                            <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                        </Grid.RowDefinitions>
                        <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarArrowStyle}" Command="{x:Static ScrollBar.LineUpCommand}">
                            <Path Fill="{StaticResource ScrollBarGlyphBrush}" Data="M 0,4 L 7,4 L 3.5,0 Z" />
                        </RepeatButton>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="{x:Static ScrollBar.PageUpCommand}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" Tag="Vertical" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="{x:Static ScrollBar.PageDownCommand}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrowStyle}" Command="{x:Static ScrollBar.LineDownCommand}">
                            <Path Fill="{StaticResource ScrollBarGlyphBrush}" Data="M 0,0 L 7,0 L 3.5,4 Z" />
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                <Setter Property="MinHeight" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                                    <ColumnDefinition Width="0.00001*" />
                                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarArrowStyle}" Command="{x:Static ScrollBar.LineLeftCommand}">
                                    <Path Fill="{StaticResource ScrollBarGlyphBrush}" Data="M 4,0 L 4,7 L 0,3.5 Z" />
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Tag="Horizontal" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="{x:Static ScrollBar.PageRightCommand}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarArrowStyle}" Command="{x:Static ScrollBar.LineRightCommand}">
                                    <Path Fill="{StaticResource ScrollBarGlyphBrush}" Data="M 0,0 L 0,7 L 4,3.5 Z" />
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
