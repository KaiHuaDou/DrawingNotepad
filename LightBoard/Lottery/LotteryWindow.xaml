<Window x:Class="LightBoard.LotteryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightBoard"
        Title="抽选"
        Width="1040"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        Background="#141414"
        Foreground="#E6E6E6"
        PreviewKeyDown="WindowPreviewKeyDown"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModeRadioStyle" BasedOn="{StaticResource LabelledRadioStyle}" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!--图标字体不用主题里的 IconTextStyle：那里固定 LineHeight=28，小字号会偏上-->
        <Style x:Key="GlyphTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="pack://application:,,,/LightBoard;component/#Segoe Fluent Icons" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>

        <!--数字步进：无底无框，只有悬停与按下的底色-->
        <Style x:Key="StepButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PART_Border" Background="Transparent" CornerRadius="5">
                            <TextBlock Style="{StaticResource GlyphTextStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Text="{TemplateBinding Tag}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--文字按钮取自设置窗口：深色底、细描边、悬停提亮-->
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A" />
                                <Setter TargetName="PART_Border" Property="Background" Value="#1A1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="CaretBrush" Value="#F0F0F0" />
            <Setter Property="SelectionBrush" Value="#4C8BF5" />
            <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--行高落在容器上，内容由 ContentPresenter 居中，文字才会上下居中-->
        <Style x:Key="DatasetItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border x:Name="PART_Mark"
                                    Width="3"
                                    Margin="0,6" HorizontalAlignment="Left"
                                    Background="Transparent"
                                    CornerRadius="2" />
                            <Border x:Name="PART_Border"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="5">
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#1F1F1F" />
                                <Setter TargetName="PART_Mark" Property="Background" Value="#4C8BF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--手柄压在选择条上，数字取自 Tag；TemplateBinding 不做数值转换，这里用普通绑定-->
        <Style x:Key="RangeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="PART_Knob"
                                Padding="7,0"
                                Background="#4C8BF5" BorderBrush="#C7DCFF" BorderThickness="1"
                                CornerRadius="15">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FFFFFF"
                                       FontSize="14"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Knob" Property="Background" Value="#6FA6FF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="PART_Knob" Property="Background" Value="#8FBCFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <local:LotteryViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <RadioButton x:Name="ContinuousRadio"
                         IsChecked="True"
                         Style="{StaticResource ModeRadioStyle}"
                         Click="ModeClick" Content="连续模式" GroupName="LotteryModeRadio" />
            <RadioButton x:Name="CollectionRadio"
                         Style="{StaticResource ModeRadioStyle}"
                         Click="ModeClick" Content="集合模式" GroupName="LotteryModeRadio" />
        </StackPanel>
        <DockPanel x:Name="RangeRow"
                   Grid.Row="1"
                   Margin="0,18,0,0"
                   Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,16,0"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="范围" />
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="MaxDownButton"
                        IsEnabled="{Binding CanDecreaseMax}"
                        Style="{StaticResource StepButtonStyle}"
                        Click="MaxStepClick" Tag="&#xE738;" ToolTip="减一" />
                <TextBox x:Name="MaxBox"
                         Width="88" Height="40"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputBoxStyle}"
                         FontSize="20"
                         KeyDown="NumberBoxKeyDown" LostFocus="NumberBoxLostFocus"
                         Text="{Binding MaxText, UpdateSourceTrigger=Explicit}"
                         TextAlignment="Center" />
                <Button x:Name="MaxUpButton"
                        IsEnabled="{Binding CanIncreaseMax}"
                        Style="{StaticResource StepButtonStyle}"
                        Click="MaxStepClick" Tag="&#xE710;" ToolTip="加一" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       Margin="16,0,10,0"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="最大值" />
            <Canvas x:Name="RangeCanvas"
                    Height="34"
                    VerticalAlignment="Center"
                    SizeChanged="RangeCanvasSizeChanged">
                <Border x:Name="RangeTrackBorder" Background="#3A3A3A" CornerRadius="5" />
                <Border x:Name="RangeFillBorder" Background="#4C8BF5" CornerRadius="5" />
                <Thumb x:Name="RangeUpperThumb"
                       Style="{StaticResource RangeThumbStyle}"
                       DragDelta="RangeThumbDragDelta" SizeChanged="RangeCanvasSizeChanged"
                       Tag="{Binding Upper}"
                       ToolTip="拖动调整上限" />
                <Thumb x:Name="RangeLowerThumb"
                       Style="{StaticResource RangeThumbStyle}"
                       DragDelta="RangeThumbDragDelta" SizeChanged="RangeCanvasSizeChanged"
                       Tag="{Binding Lower}"
                       ToolTip="拖动调整下限" />
            </Canvas>
        </DockPanel>
        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <!--连续模式下左侧没有内容，整列收成 0 让结果区占满-->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="{x:Type ColumnDefinition}">
                            <Setter Property="Width" Value="2*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContinuous}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="CollectionPanel" Grid.Column="0" Visibility="{Binding IsCollection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="数据集" />
                    <Button x:Name="RemoveDatasetButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RemoveDatasetClick" Content="移除" />
                    <Button x:Name="ImportDatasetButton"
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ImportDatasetClick" Content="导入" />
                </DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Bottom"
                           Margin="0,8,0,0"
                           Foreground="#B8B8B8"
                           FontSize="15"
                           Text="{Binding Status}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="DatasetTextBox"
                         DockPanel.Dock="Bottom"
                         MinHeight="110" MaxHeight="180"
                         Margin="0,10,0,0" VerticalContentAlignment="Top"
                         IsEnabled="{Binding HasDataset}"
                         Style="{StaticResource InputBoxStyle}"
                         AcceptsReturn="False"
                         Text="{Binding SelectedDatasetText}"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <ListBox x:Name="DatasetList"
                         Padding="0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource DatasetItemStyle}"
                         ItemsSource="{Binding Datasets}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectedItem="{Binding SelectedDataset, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#E6E6E6"
                                       FontSize="18"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel x:Name="ResultPanel" Grid.Column="1">
                <DockPanel.Style>
                    <Style TargetType="{x:Type DockPanel}">
                        <Setter Property="Margin" Value="24,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContinuous}" Value="True">
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,12"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="抽选结果" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="CountDownButton"
                                IsEnabled="{Binding CanDecreaseCount}"
                                Style="{StaticResource StepButtonStyle}"
                                Click="CountStepClick" Tag="&#xE738;" ToolTip="减一" />
                        <TextBox x:Name="CountBox"
                                 Width="88" Height="40"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanDraw}"
                                 Style="{StaticResource InputBoxStyle}"
                                 FontSize="24"
                                 KeyDown="NumberBoxKeyDown" LostFocus="NumberBoxLostFocus"
                                 Text="{Binding CountText, UpdateSourceTrigger=Explicit}"
                                 TextAlignment="Center" />
                        <Button x:Name="CountUpButton"
                                IsEnabled="{Binding CanIncreaseCount}"
                                Style="{StaticResource StepButtonStyle}"
                                Click="CountStepClick" Tag="&#xE710;" ToolTip="加一" />
                    </StackPanel>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DrawOneButton"
                                Grid.Column="0"
                                MinHeight="52"
                                Margin="0,0,6,0"
                                IsEnabled="{Binding CanDraw}"
                                Style="{StaticResource ActionButtonStyle}"
                                FontSize="22"
                                Click="DrawOneClick" Content="抽选一个" />
                        <Button x:Name="DrawManyButton"
                                Grid.Column="1"
                                MinHeight="52"
                                Margin="6,0,0,0"
                                IsEnabled="{Binding CanDraw}"
                                Style="{StaticResource ActionButtonStyle}"
                                FontSize="22"
                                Click="DrawManyClick" Content="抽选多个" />
                    </Grid>
                </DockPanel>
                <Grid x:Name="ResultHost">
                    <ScrollViewer HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ResultList"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ItemsSource="{Binding Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="12,4"
                                            Background="#262626"
                                            CornerRadius="6">
                                        <TextBlock Foreground="#E6E6E6" FontSize="34" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ResultPlaceholderText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#6E6E6E"
                               FontSize="20"
                               Text="尚未抽选">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
