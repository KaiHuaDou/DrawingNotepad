<Window x:Class="LightBoard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightBoard"
        Title="设置"
        Width="780"
        Height="620"
        Background="#111111"
        Foreground="#EEEEEE"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ControlTemplate x:Key="FieldErrorTemplate">
            <Border BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="5" />
        </ControlTemplate>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F0F0F0" />
        </Style>

        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="UnitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="CaretBrush" Value="#F0F0F0" />
            <Setter Property="SelectionBrush" Value="#4C8BF5" />
            <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A" />
                                <Setter TargetName="PART_Border" Property="Background" Value="#1A1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="pack://application:,,,/LightBoard;component/#Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#7A7A7A" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="ToolTip" Value="清除此项设置，按程序默认值生效" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSet}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel MinHeight="40" Background="Transparent">
                            <Border x:Name="PART_Box"
                                    DockPanel.Dock="Right"
                                    Width="23" Height="23"
                                    VerticalAlignment="Center"
                                    Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                    CornerRadius="5">
                                <Path x:Name="PART_Mark"
                                      Width="10" Height="8"
                                      Visibility="Collapsed"
                                      Stroke="#4C8BF5" StrokeThickness="1.8"
                                      Data="M 0,3.5 L 3.2,6.6 L 9,0.6" Stretch="Fill" StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Box" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Box" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="PART_Ring"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                        CornerRadius="9">
                                    <Ellipse x:Name="PART_Dot"
                                             Width="6" Height="6"
                                             Visibility="Collapsed"
                                             Fill="#4C8BF5" />
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PART_Bg" Background="Transparent" CornerRadius="6">
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Border x:Name="PART_Bar"
                                        DockPanel.Dock="Left"
                                        Width="3"
                                        Margin="0,3,10,3"
                                        Background="Transparent"
                                        CornerRadius="3" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Bg" Property="Background" Value="#1B1B1B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Bg" Property="Background" Value="#1F1F1F" />
                                <Setter TargetName="PART_Bar" Property="Background" Value="#4C8BF5" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="24,16,24,24">
                <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitleStyle}" Text="{Binding Title}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Items}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SettingsField}">
            <DockPanel MinHeight="40">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ResetButtonStyle}"
                        Click="RowResetClick" Content="&#xE72C;"
                        Tag="{Binding}" />
                <TextBlock DockPanel.Dock="Right"
                           Width="72"
                           Margin="12,0,0,0"
                           Style="{StaticResource UnitTextStyle}"
                           Text="{Binding Unit}" />
                <Button DockPanel.Dock="Right"
                        Margin="4,0,0,0"
                        Style="{StaticResource StepperButtonStyle}"
                        Click="StepUpClick" Content="+"
                        Tag="{Binding}" />
                <TextBox DockPanel.Dock="Right"
                         Width="92" Height="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource ValueBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center"
                         ToolTip="{Binding Hint}"
                         Validation.ErrorTemplate="{StaticResource FieldErrorTemplate}" />
                <Button DockPanel.Dock="Right"
                        Margin="0,0,4,0"
                        Style="{StaticResource StepperButtonStyle}"
                        Click="StepDownClick" Content="−"
                        Tag="{Binding}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SettingsToggle}">
            <DockPanel MinHeight="40">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ResetButtonStyle}"
                        Click="RowResetClick" Content="&#xE72C;"
                        Tag="{Binding}" />
                <CheckBox IsChecked="{Binding Checked}" Style="{StaticResource RowCheckBoxStyle}" Content="{Binding Label}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SettingsChoice}">
            <DockPanel MinHeight="40">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ResetButtonStyle}"
                        Click="RowResetClick" Content="&#xE72C;"
                        Tag="{Binding}" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <RadioButton Margin="0,0,20,0"
                                 IsChecked="{Binding First}"
                                 Style="{StaticResource FlatRadioStyle}"
                                 Content="{Binding FirstLabel}"
                                 GroupName="{Binding GroupName}" />
                    <RadioButton IsChecked="{Binding Second}"
                                 Style="{StaticResource FlatRadioStyle}"
                                 Content="{Binding SecondLabel}"
                                 GroupName="{Binding GroupName}" />
                </StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SettingsText}">
            <DockPanel MinHeight="40">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ResetButtonStyle}"
                        Click="RowResetClick" Content="&#xE72C;"
                        Tag="{Binding}" />
                <TextBlock DockPanel.Dock="Right" Width="72" Margin="12,0,0,0" />
                <TextBox DockPanel.Dock="Right"
                         Width="172" Height="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource ValueBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="0,15,0,0">
        <Border DockPanel.Dock="Bottom" Background="#141414">
            <DockPanel Margin="20,15">
                <Button DockPanel.Dock="Left"
                        MinWidth="120"
                        Style="{StaticResource TextButtonStyle}"
                        Click="ResetClick" Content="恢复默认值" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button MinWidth="96"
                            Margin="0,0,8,0"
                            Style="{StaticResource TextButtonStyle}"
                            Click="OkClick" Content="确定" IsDefault="True" />
                    <Button x:Name="CancelButton"
                            MinWidth="96"
                            Style="{StaticResource TextButtonStyle}"
                            Click="CancelClick" Content="取消" IsCancel="True" />
                </StackPanel>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"
                               Foreground="#FF6B6B"
                               FontSize="15"
                               Text="有输入不合范围" />
                    <TextBlock x:Name="RestartNoticeText"
                               Margin="14,0,0,0"
                               Foreground="#9A9A9A"
                               FontSize="15"
                               Text="部分设置需重启后生效" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Left" Padding="6" Background="#171717">
            <ListBox x:Name="SectionList"
                     Width="150"
                     Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Title"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}"
                     SelectionChanged="SectionListSelectionChanged" />
        </Border>
        <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ContentControl Focusable="False" Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Window>
