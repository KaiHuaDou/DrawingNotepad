<Window x:Class="LightBoard.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出"
        Width="560" Height="420"
        Background="#1E1E1E"
        Foreground="{DynamicResource ChromeForegroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="OptionRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="PART_Ring"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                        CornerRadius="9">
                                    <Ellipse x:Name="PART_Dot"
                                             Width="6" Height="6"
                                             Visibility="Collapsed"
                                             Fill="#4C8BF5" />
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <TextBlock x:Name="PageCountText"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="#9A9A9A" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        MinWidth="96" Margin="0,0,8,0"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="取消" IsCancel="True" />
                <Button x:Name="ExportButton"
                        MinWidth="96"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="导出" IsDefault="True" Click="ExportClick" />
            </StackPanel>
        </DockPanel>
        <StackPanel>
            <TextBlock Margin="0,0,0,8" FontSize="16" Text="格式" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PngRadio" Tag="Png" Content="PNG 图片"
                             Style="{StaticResource OptionRadioStyle}" />
                <RadioButton x:Name="PdfRadio" Tag="Pdf" Content="PDF 文档"
                             Style="{StaticResource OptionRadioStyle}" />
                <RadioButton x:Name="SvgRadio" Tag="Svg" Content="SVG 矢量图"
                             Style="{StaticResource OptionRadioStyle}" />
            </StackPanel>
            <TextBlock x:Name="FormatHintText"
                       Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="#9A9A9A"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,22,0,8" FontSize="16" Text="缩放" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Scale25Radio" Tag="25" Content="25%"
                             Style="{StaticResource OptionRadioStyle}" />
                <RadioButton x:Name="Scale50Radio" Tag="50" Content="50%"
                             Style="{StaticResource OptionRadioStyle}" />
                <RadioButton x:Name="Scale100Radio" Tag="100" Content="100%"
                             Style="{StaticResource OptionRadioStyle}" />
            </StackPanel>
            <TextBlock Margin="0,22,0,8" FontSize="16" Text="导出到" />
            <DockPanel>
                <Button x:Name="BrowseButton"
                        DockPanel.Dock="Right"
                        MinWidth="72"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="浏览" Click="BrowseClick" />
                <TextBox x:Name="PathBox"
                         Height="36"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource DialogTextBoxStyle}" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
