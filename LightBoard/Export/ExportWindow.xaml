<Window x:Class="LightBoard.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出"
        MaxWidth="760"
        MaxHeight="600"
        Background="#1E1E1E"
        Foreground="{DynamicResource ChromeForegroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OptionRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DotFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="PART_Ring"
                                        Width="20" Height="20"
                                        VerticalAlignment="Center"
                                        Background="#1F1F1F" BorderBrush="#4A4A4A" BorderThickness="1"
                                        CornerRadius="9">
                                    <Ellipse x:Name="PART_Dot"
                                             Width="6" Height="6"
                                             Visibility="Collapsed"
                                             Fill="#4C8BF5" />
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Ring" Property="BorderBrush" Value="#4C8BF5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <TextBlock x:Name="PageCountText"
                       VerticalAlignment="Center"
                       Foreground="#9A9A9A"
                       FontSize="15" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="取消" IsCancel="True" />
                <Button x:Name="ExportButton"
                        MinWidth="96"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="ExportClick" Content="导出" IsDefault="True" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,30,0" Style="{StaticResource FieldLabelStyle}" Text="格式" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="PngRadio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="PNG" Tag="Png" />
                <RadioButton x:Name="PdfRadio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="PDF" Tag="Pdf" />
                <RadioButton x:Name="SvgRadio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="SVG" Tag="Svg" />
            </StackPanel>
            <TextBlock Grid.Row="1"
                       Margin="0,24,30,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="缩放" />
            <StackPanel Grid.Row="1" Grid.Column="1"
                        Margin="0,24,0,0"
                        Orientation="Horizontal">
                <RadioButton x:Name="Scale25Radio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="25%" Tag="25" />
                <RadioButton x:Name="Scale50Radio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="50%" Tag="50" />
                <RadioButton x:Name="Scale100Radio"
                             Style="{StaticResource OptionRadioStyle}"
                             Content="100%" Tag="100" />
            </StackPanel>
            <TextBlock Grid.Row="2"
                       Margin="0,24,30,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="路径" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,24,0,0">
                <Button x:Name="BrowseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="BrowseClick" Content="..." />
                <TextBox x:Name="PathBox"
                         Height="36"
                         Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Style="{StaticResource DialogTextBoxStyle}" />
            </DockPanel>
            <TextBlock Grid.Row="3"
                       Margin="0,24,30,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="命名" />
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,24,0,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <RadioButton x:Name="TimeRadio"
                                 Style="{StaticResource OptionRadioStyle}"
                                 Content="时间" Tag="Time" ToolTip="按当前时间生成" />
                    <RadioButton x:Name="CustomRadio"
                                 Style="{StaticResource OptionRadioStyle}"
                                 Content="手动" Tag="Custom" />
                </StackPanel>
                <TextBox x:Name="NameBox"
                         Height="36"
                         Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Style="{StaticResource DialogTextBoxStyle}"
                         ToolTip="无需填写扩展名" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
